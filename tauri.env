#!/bin/bash

# Recommended environment variables for working with Tauri. This file
# IS committed to the Git repo and SHALL NEVER contain any secrets or
# passwords.

# Some Fedora Linux versions detect multiple architectures. Specify
# your arch. (https://github.com/tauri-apps/tauri/issues/13258)
export ARCH=x86_64

# Recent versions of linuxdeploy act up with Tauri. Do not strip
# binary (Yes, this is ugly and increases executable size).
# (https://github.com/tauri-apps/tauri/issues/11149)
export NO_STRIP=true

# GBM buffer issue on some Nvidia graphics cards.
# (https://github.com/tauri-apps/tauri/issues/13493)
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export WEBKIT_DISABLE_COMPOSITING_MODR=1
